# Sizatek.com · sitio estático
Options -Indexes
DirectoryIndex index.html

# HTTPS y sin www
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://sizatek.com/$1 [R=301,L]

# ── Redirecciones desde las URLs del WordPress anterior ──
RewriteRule ^internet-rapido-para-hogares-y-empresas-sizatek/(tienda|precios|carrito|finalizar-compra|finalizar-compra/gracias-por-tu-compra)/?$ /#paquetes [R=301,L,NE]
RewriteRule ^(categoria-producto|producto)/.*$ /#paquetes [R=301,L,NE]
RewriteRule ^internet-rapido-para-hogares-y-empresas-sizatek/nosotros/?$ /#nosotros [R=301,L,NE]
RewriteRule ^(internet-rapido-para-hogares-y-empresas-sizatek/)?encuentra-tu-paquete-de-internet-ideal-en-sizatek-guia-personalizada/?$ /#contacto [R=301,L,NE]
RewriteRule ^prueba-tu-velocidad/?$ /#velocidad [R=301,L,NE]
RewriteRule ^(internet-rapido-para-hogares-y-empresas-sizatek/)?mi-cuenta(/.*)?$ https://clientes.sizatek.com/cliente/login [R=301,L]
RewriteRule ^aviso-de-privacidad-2/?$ /wp-content/uploads/2024/07/aviso-de-privacidad.pdf [R=301,L]
RewriteRule ^tet/?$ / [R=301,L]
# WordPress ya no existe aquí
RewriteRule ^(wp-admin|wp-login\.php|wp-json|xmlrpc\.php|wp-includes)(/.*)?$ - [G,L]
RewriteRule ^wp-content/(?!uploads/).*$ - [G,L]

ErrorDocument 404 /404.html

# ── Seguridad ──
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# ── Caché y compresión ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType application/pdf "access plus 7 days"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
